public class Main {
    static class Student {
        String name;
        int[] quizzes;

        Student(String name, int[] quizzes) {
            this.name = name;
            this.quizzes = quizzes;
        }

        double getAverage() {
            int sum = 0;

            for (int score : quizzes) {
                sum += score;
            }

            return (double) sum / quizzes.length;
        }
    }

    public static void main(String[] args) {
        String[] names = {"Karl", "John", "Mark", "James", "Alex"};
        int[][] quizData = {
            {90, 85, 88, 92},
            {95, 90, 85, 85},
            {80, 82, 84, 86},
            {95, 90, 85, 85},
            {88, 87, 89, 90}
        };

        Student[] students = new Student[names.length];

        for (int i = 0; i < students.length; i++) {
            students[i] = new Student(names[i], quizData[i]);
        }

        for (int i = 0; i < students.length - 1; i++) {
            for (int j = 0; j < students.length - 1 - i; j++) {
                if (students[j].getAverage() < students[j + 1].getAverage()) {
                    Student temp = students[j];
                    students[j] = students[j + 1];
                    students[j + 1] = temp;
                }
            }
        }

        System.out.println("========== CLASS LEADERBOARD ==========");
        System.out.printf("%-8s %-12s %-10s%n", "Rank", "Name", "Average");
        System.out.println("---------------------------------------");

        int rank = 1;

        for (int i = 0; i < students.length; i++) {
            if (i > 0 && students[i].getAverage() != students[i - 1].getAverage()) {
                rank = i + 1;
            }

            System.out.printf("%-8d %-12s %-10.2f%n",
                    rank, students[i].name, students[i].getAverage());
        }

        String searchName = "Mark";
        int studentRank = linearSearch(students, searchName);

        if (studentRank != -1) {
            System.out.println("\n" + searchName + "'s rank: " + studentRank);
        } else {
            System.out.println("\nStudent not found: " + searchName);
        }
    }

    static int linearSearch(Student[] students, String name) {
        for (int i = 0; i < students.length; i++) {
            if (students[i].name.equalsIgnoreCase(name)) {
                int rank = 1;

                for (int j = 0; j < i; j++) {
                    if (students[j].getAverage() > students[i].getAverage()) {
                        rank++;
                    }
                }

                return rank;
            }
        }

        return -1;
    }
}
