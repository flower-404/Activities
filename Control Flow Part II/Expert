import java.util.Scanner;

public class Main {
    static Scanner input = new Scanner(System.in);
    static int[][] warehouse = {
        {10, 5, -1},
        {3, 8, 2},
        {1, -1, 7}
    };

    public static void main(String[] args) {
        int choice;

        do {
            System.out.println("\n=== Warehouse Inventory Scanner ===");
            System.out.println("1. Display Inventory");
            System.out.println("2. Total Inventory");
            System.out.println("3. Find Critically Low Shelf");
            System.out.println("4. Restock Shelf");
            System.out.println("5. Exit");
            System.out.print("Choose an option: ");
            choice = input.nextInt();

            switch (choice) {
                case 1:
                    displayInventory();
                    break;
                case 2:
                    totalInventory();
                    break;
                case 3:
                    findLowShelf();
                    break;
                case 4:
                    restockShelf();
                    break;
                case 5:
                    System.out.println("Exiting inventory system...");
                    break;
                default:
                    System.out.println("Invalid choice. Try again.");
            }
        } while (choice != 5);
    }

    static void displayInventory() {
        System.out.println("\nWarehouse Inventory:");

        for (int row = 0; row < warehouse.length; row++) {
            for (int col = 0; col < warehouse[row].length; col++) {
                if (warehouse[row][col] == -1) {
                    System.out.print("[DAMAGED] ");
                } else {
                    System.out.print(warehouse[row][col] + " ");
                }
            }
            System.out.println();
        }
    }

    static void totalInventory() {
        int total = 0;

        for (int row = 0; row < warehouse.length; row++) {
            for (int col = 0; col < warehouse[row].length; col++) {
                if (warehouse[row][col] == -1) {
                    continue;
                }
                total += warehouse[row][col];
            }
        }

        System.out.println("Total inventory: " + total);
    }

    static void findLowShelf() {
        boolean found = false;

        for (int row = 0; row < warehouse.length; row++) {
            for (int col = 0; col < warehouse[row].length; col++) {
                if (warehouse[row][col] == -1) {
                    continue;
                }

                if (warehouse[row][col] <= 2) {
                    System.out.println("First critically low shelf: Row "
                            + (row + 1) + ", Column " + (col + 1)
                            + " with " + warehouse[row][col] + " items");
                    found = true;
                    break;
                }
            }

            if (found) {
                break;
            }
        }

        if (!found) {
            System.out.println("No critically low shelves found.");
        }
    }

    static void restockShelf() {
        System.out.print("Enter row (1-" + warehouse.length + "): ");
        int row = input.nextInt();

        System.out.print("Enter column (1-" + warehouse[0].length + "): ");
        int col = input.nextInt();

        if (row < 1 || row > warehouse.length
                || col < 1 || col > warehouse[0].length) {
            System.out.println("Invalid shelf location.");
            return;
        }

        if (warehouse[row - 1][col - 1] == -1) {
            System.out.println("This shelf is damaged and cannot be restocked.");
            return;
        }

        int amount;

        while (true) {
            System.out.print("Enter quantity to add (greater than 0): ");
            amount = input.nextInt();

            if (amount > 0) {
                break;
            }

            System.out.println("Invalid quantity. Enter a positive number.");
        }

        warehouse[row - 1][col - 1] += amount;
        System.out.println("Restocking successful. New quantity: "
                + warehouse[row - 1][col - 1]);
    }
}
