public class Main {
    public static void main(String[] args) {

        int size = 5;

        for (int row = 1; row <= size; row++) {

            if (row == 3) {
                continue; // Skip yung third row
            }

            for (int column = 1; column <= row; column++) {

                if (column == 4) {
                    break; // Stop yung inner loop kapag umabot sa column 4
                }

                System.out.print("* ");
            }

            System.out.println();
        }
    }
}
