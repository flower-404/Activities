public class Main {
    public static void main(String[] args) {

        double averageGrade = 88;
        int absences = 2;

        boolean passed = (averageGrade >= 75 && absences <= 3) || (averageGrade >= 90);

        System.out.println("=== GRADE THRESHOLD CHECKER ===");
        System.out.println("Average Grade: " + averageGrade);
        System.out.println("Number of Absences: " + absences);

        if (passed) {
            System.out.println("Result: PASS");
            System.out.println("Reason: Na-meet ng student yung passing requirements");
        } else {
            System.out.println("Result: FAIL");
            System.out.println("Reason: Hindi na-meet ng student yung passing requirements");
        }
    }
}
